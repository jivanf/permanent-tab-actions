{
    "manifest_version": 2,
    "name": "Permanent Tab Actions",
    "version": "0.1.0",
    "description": "Keep pinned and muted tabs permanent across Firefox sessions.",
    "homepage_url": "https://github.com/jivanf/permanent-tab-actions",
    "browser_specific_settings": {
        "gecko": {
            "id": "@permanent-tab-actions.jivanf",
            "update_url": "https://github.com/jivanf/permanent-tab-actions/releases/latest/download/updates.json",
            "strict_min_version": "142.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "incognito": "not_allowed",
    "permissions": ["tabs", "sessions", "storage", "cookies"],
    "background": {
        "scripts": ["background.js"],
        "persistent": true
    },
    "icons": {
        "48": "icon.svg",
        "96": "icon.svg"
    },
    "content_security_policy": "script-src 'self'; object-src 'none'; base-uri 'none'"
}
